            {
              "value": "postgre_sql",
              "activities": [
                {
                  "name": "PostgreSQL Column Metadata",
                  "type": "Lookup",
                  "dependsOn": [],
                  "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 2,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                  },
                  "typeProperties": {
                    "source": {
                      "type": "PostgreSqlSource",
                      "query": {
                        "value": "SELECT \n    a.column_name AS COLUMN_NAME\n    ,a.data_type AS DATA_TYPE\n   ,a.character_maximum_length AS DATA_LENGTH\n    ,a.numeric_precision AS DATA_PRECISION\n    ,a.numeric_scale AS DATA_SCALE\n    ,a.is_nullable AS NULLABLE\n    ,c.constraint_type AS PRIMARY_KEY\n  FROM information_schema.columns AS a\n  LEFT JOIN information_schema.key_column_usage AS b\n  ON a.table_schema = b.table_schema \n  AND a.table_name = b.table_name\n  AND a.column_name = b.column_name\n  LEFT JOIN information_schema.table_constraints AS c\nON b.constraint_name = c.constraint_name\nAND c.constraint_type = 'PRIMARY KEY'\n WHERE a.table_schema = '@{pipeline().parameters.primary_config.source_details_schema_name}'\n   AND a.table_name   = '@{pipeline().parameters.primary_config.source_details_table_name}'\nORDER BY a.ordinal_position\n",
                        "type": "Expression"
                      }
                    },
                    "firstRowOnly": false,
                    "datasetSettings": {
                      "annotations": [],
                      "type": "PostgreSqlTable",
                      "schema": [],
                      "typeProperties": {},
                      "externalReferences": {
