                      "type": "Expression"
                    },
                    "type": "string"
                  },
                  "default_lakehouse_workspace_id": {
                    "value": {
                      "value": "@pipeline().libraryVariables.metadata_workspace_id",
                      "type": "Expression"
                    },
                    "type": "string"
                  },
                  "metadata_lakehouse_id": {
                    "value": {
                      "value": "@pipeline().libraryVariables.metadata_lakehouse_id",
                      "type": "Expression"
                    },
                    "type": "string"
                  },
