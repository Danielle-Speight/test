{
  "properties": {
    "activities": [
      {
        "type": "IfCondition",
        "typeProperties": {
          "expression": {
            "value": "@or(contains(variables('primary_config')[0],'watermark_details_column_name'),\nnot(contains(variables('primary_config')[0],'source_details_query'))\n)",
            "type": "Expression"
          },
          "ifTrueActivities": [
            {
              "type": "SetVariable",
              "typeProperties": {
                "variableName": "next_watermark_value",
                "value": {
                  "value": "@activity('Get Max Value of Watermark').output.pipelineReturnValue.watermark_value",
                  "type": "Expression"
                }
              },
              "policy": {
                "secureInput": false,
                "secureOutput": false
              },
              "name": "Set Watermark Value",
              "dependsOn": [
                {
                  "activity": "Get Max Value of Watermark",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ]
            },
            {
              "type": "ExecutePipeline",
              "typeProperties": {
                "pipeline": {
                  "referenceName": "a1139d28-63f0-b671-4372-12185c5832a3",
                  "type": "PipelineReference"
                },
                "parameters": {
                  "primary_config": {
                    "value": "@variables('primary_config')[0]",
                    "type": "Expression"
                  },
                  "source_datastore_config": {
                    "value": "@variables('source_datastore_config')[0]",
                    "type": "Expression"
                  }
                },
                "waitOnCompletion": true
              },
              "policy": {
                "secureInput": false
              },
              "name": "Get Max Value of Watermark",
              "dependsOn": []
            }
          ],
          "ifFalseActivities": []
        },
        "name": "If Watermark Value Used",
        "description": "If it's a database source table that needs incremental ingestion or the source doesn't use a query",
        "dependsOn": [
          {
            "activity": "Folderpath with Timestamp",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
      {
        "type": "SetVariable",
        "typeProperties": {
          "variableName": "filename_w_timestamp",
          "value": {
            "value": "@concat(\n   replace(variables('primary_config')[0].source_details_staging_folder_path,'/','_')\n   ,'_'\n   ,formatDateTime(utcnow(),'yyyy')\n   ,formatDateTime(utcnow(),'MM')\n   ,formatDateTime(utcnow(),'dd')\n   ,formatDateTime(utcnow(),'HH')\n   ,formatDateTime(utcnow(),'mm')\n   ,formatDateTime(utcnow(),'ss')\n)",
            "type": "Expression"
          }
        },
        "policy": {
          "secureInput": false,
          "secureOutput": false
        },
        "name": "Filename with Timestamp",
        "dependsOn": [
          {
            "activity": "Watermark Details",
            "dependencyConditions": [
              "Succeeded"
            ]
          },
          {
            "activity": "Orchestration Metadata",
            "dependencyConditions": [
              "Succeeded"
            ]
          },
          {
            "activity": "Primary Config",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
      {
        "type": "SetVariable",
        "typeProperties": {
          "variableName": "folderpath_w_ingestion_type",
          "value": {
            "value": "@if(endswith(variables('primary_config')[0].source_details_staging_folder_path, '/')\n,   concat(\n            variables('primary_config')[0].source_details_staging_folder_path\n            ,formatDateTime(utcnow(),'yyyy')\n            ,formatDateTime(utcnow(),'MM')\n            ,formatDateTime(utcnow(),'dd')\n            ,formatDateTime(utcnow(),'HH')\n            ,formatDateTime(utcnow(),'mm')\n            ,formatDateTime(utcnow(),'ss')\n            , '/')\n,   concat(\n            variables('primary_config')[0].source_details_staging_folder_path\n            ,'/'\n            ,formatDateTime(utcnow(),'yyyy')\n            ,formatDateTime(utcnow(),'MM')\n            ,formatDateTime(utcnow(),'dd')\n            ,formatDateTime(utcnow(),'HH')\n            ,formatDateTime(utcnow(),'mm')\n            ,formatDateTime(utcnow(),'ss')\n            , '/')\n)",
            "type": "Expression"
          }
        },
        "policy": {
          "secureInput": false,
          "secureOutput": false
        },
        "name": "Folderpath with Timestamp",
        "dependsOn": [
          {
            "activity": "Filename with Timestamp",
            "dependencyConditions": [
              "Succeeded"
            ]
          },
          {
            "activity": "Staging Lakehouse Name",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
