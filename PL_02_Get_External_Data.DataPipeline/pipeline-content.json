          "scripts": [
            {
              "text": {
                "value": "EXEC [dbo].[Pivot_Primary_Config] @table_id = @table_id",
                "type": "Expression"
              },
              "type": "Query",
              "parameters": [
                {
                  "name": "table_id",
                  "type": "Int32",
                  "value": {
                    "value": "@pipeline().parameters.table_id",
                    "type": "Expression"
                  },
                  "direction": "Input"
                }
              ]
            },
            {
              "text": {
                "value": "SELECT  *\nFROM    dbo.Data_Pipeline_Metadata_Orchestration\nWHERE   Table_ID = @{pipeline().parameters.table_id}\nAND     Trigger_Name = '@{pipeline().parameters.trigger_name}'",
                "type": "Expression"
              },
              "type": "Query"
            },
            {
              "text": {
                "value": "EXEC [dbo].[Get_Datastore_Details] @datastore_name = @datastore_name",
                "type": "Expression"
              },
              "type": "Query",
              "parameters": [
                {
                  "name": "datastore_name",
                  "type": "String",
                  "value": {
                    "value": "@pipeline().parameters.target_datastore",
                    "type": "Expression"
                  },
                  "direction": "Input"
                }
              ]
            },
            {
              "text": {
                "value": "EXEC [dbo].[Get_Datastore_Details] @datastore_name = @datastore_name",
                "type": "Expression"
              },
              "type": "Query",
              "parameters": [
                {
                  "name": "datastore_name",
                  "type": "String",
                  "value": {
                    "value": "@pipeline().parameters.source_datastore_name",
                    "type": "Expression"
                  },
                  "direction": "Input"
                }
              ]
            }
          ],
          "scriptBlockExecutionTimeout": "02:00:00"
        },
